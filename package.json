{
  "name": "pharmacy-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Telegram pharmacy ordering bot POC (India): prescription/text extraction with Gemini, OTC rules, FEFO stock, mock payment.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch --exclude ./data src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@google/genai": "^2.30.0",
    "fuse.js": "^7.5.0",
    "grammy": "^1.46.0",
    "lowdb": "^7.0.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}

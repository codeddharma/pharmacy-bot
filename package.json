{
  "name": "pharmacy-bot",
  "version": "0.1.0",
  "private": true,
  "description": "DawaDesk: pharmacy ordering on Telegram and WhatsApp, with a staff dashboard (India).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch --exclude ./data --exclude ./dashboard src/index.ts",
    "dev:dashboard": "npm --prefix dashboard run dev",
    "build": "npm --prefix dashboard run build",
    "typecheck": "tsc --noEmit && npm --prefix dashboard run typecheck",
    "test": "node --import tsx --test test/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:seed": "tsx src/cli.ts seed",
    "user:create": "tsx src/cli.ts create-user",
    "user:password": "tsx src/cli.ts set-password"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@fastify/cookie": "^11.1.3",
    "@fastify/static": "^10.1.7",
    "@google/genai": "^2.30.0",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "fuse.js": "^7.5.0",
    "grammy": "^1.46.0",
    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2"
  }
}

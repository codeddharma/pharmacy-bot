# ---------------------------------------------------------------- server
PORT=3000
# 127.0.0.1 behind Nginx (aaPanel). Use 0.0.0.0 only if nothing sits in front.
HOST=127.0.0.1
# The dashboard's public address. Webhooks and payment links are built from it.
PUBLIC_URL=https://admin.example.com
TZ=Asia/Kolkata

# ---------------------------------------------------------------- database
# PostgreSQL in production, e.g. postgres://dawadesk:PASSWORD@127.0.0.1:5432/dawadesk
# Leave empty for local development: an embedded database is kept in PGLITE_DIR.
DATABASE_URL=
PGLITE_DIR=./data/pgdata
UPLOADS_DIR=./data/uploads

# ---------------------------------------------------------------- Telegram
# Token from @BotFather.
TELEGRAM_BOT_TOKEN=
# "polling" on your laptop, "webhook" on the server (needs an https PUBLIC_URL).
TELEGRAM_MODE=polling
# Any long random string; Telegram sends it back so we know the webhook call is real.
TELEGRAM_WEBHOOK_SECRET=

# ---------------------------------------------------------------- WhatsApp Cloud API (production)
# From Meta for Developers -> your app -> WhatsApp -> API Setup. Leave empty to turn WhatsApp off.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any string; enter the same one as the webhook "Verify token" in the Meta app.
WHATSAPP_VERIFY_TOKEN=
# App settings -> Basic -> App secret. Used to check webhook signatures.
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v23.0

# ---------------------------------------------------------------- reading prescriptions (Gemini)
EXTRACTOR=gemini
GEMINI_API_KEY=
# Copy the exact model ID from Google AI Studio.
GEMINI_MODEL=gemini-3.1-flash-lite

# ---------------------------------------------------------------- payments
# "mock" = fake UPI page for testing. "razorpay" = real payments.
PAYMENT_PROVIDER=mock
# Razorpay Dashboard -> Account & Settings -> API Keys. Start with rzp_test_ keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay Dashboard -> Webhooks: the secret you set for https://<PUBLIC_URL>/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=

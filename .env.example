# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Extraction: Gemini free tier (create the key in Google AI Studio).
# Copy the exact model ID from AI Studio's model list; free-tier models change often.
# Without a key, typed lists still work but photos and PDFs are turned off.
EXTRACTOR=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Try this if handwriting accuracy is poor and your free tier includes it:
# GEMINI_MODEL=gemini-3-flash-preview

# Telegram chat IDs that get new-order alerts and can run admin commands (comma-separated).
# Message @userinfobot on Telegram to find yours.
ADMIN_CHAT_IDS=

# Shown to customers
PHARMACY_NAME=Demo Pharmacy
PHARMACY_PHONE=+91 00000 00000

# Delivery: PIN code prefixes you deliver to (e.g. 380,382). Empty = everywhere.
SERVICEABLE_PINCODE_PREFIXES=
DELIVERY_FEE=40
FREE_DELIVERY_ABOVE=499

# Timers
RESERVATION_MINUTES=15
SESSION_TIMEOUT_MINUTES=30
UPLOAD_RETENTION_DAYS=30

DATA_DIR=./data
TZ=Asia/Kolkata
